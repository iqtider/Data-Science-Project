summary(clean_parking$total_inventory)
clean_parking %>% filter(total_inventory < quantile(total_inventory, 0.75, na.rm=TRUE) + (1.5 * IQR(total_inventory, na.rm=TRUE)))
clean_parking %>% filter(total_inventory < quantile(total_inventory, 0.75, na.rm=TRUE) + (1.5 * IQR(total_inventory, na.rm=TRUE))) %>% max()
clean_parking %>% filter(total_inventory < quantile(total_inventory, 0.75, na.rm=TRUE) + (1.5 * IQR(total_inventory, na.rm=TRUE))) %>% pull(total_inventory) %>% max()
ggplot(clean_parking, aes(x=total_inventory)) +
geom_boxplot(outlier.shape = NA) +
coord_cartesian(xlim = c(0, ufence)) +
theme_minimal() + labs(x = "Parking Spots", title = "Spread of Parking Lot Capacity") +
theme(axis.text.y=element_blank())
#Whisker minimum
clean_parking %>% filter(total_inventory < quantile(total_inventory, 0.75, na.rm=TRUE) + (1.5 * IQR(total_inventory, na.rm=TRUE))) %>% pull(total_inventory) %>% max()
