clean_parking <- parking_data %>% filter(total_inventory > 0)
#Boxplot of parking lot capacity
ufence <- quantile(clean_parking$total_inventory, 0.75, na.rm=TRUE) + (1.5 * IQR(clean_parking$total_inventory, na.rm=TRUE))
ggplot(clean_parking, aes(x=total_inventory)) +
geom_boxplot(outlier.shape = NA) +
coord_cartesian(xlim = c(0, ufence)) +
theme_minimal() + labs(x = "Parking Spots", title = "Spread of Parking Lot Capacity") +
theme(axis.text.y=element_blank())
#Full boxplot with outliers
ggplot(clean_parking, aes(x=total_inventory)) +
geom_boxplot()
