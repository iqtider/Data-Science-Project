findIQROutliers <- function(x, s, n){
lfence <- quantile(x, 0.25, na.rm=TRUE) - (1.5 * IQR(x, na.rm=TRUE))
ufence <- quantile(x, 0.75, na.rm=TRUE) + (1.5 * IQR(x, na.rm=TRUE))
#print(paste0("IQR: ", IQR(x, na.rm=TRUE), " (", quantile(x, probs = 0.25, na.rm=TRUE), ", ", quantile(x, probs = 0.75, na.rm=TRUE), ") ", "lfence: ", lfence, " ufence: ", ufence))
temp <- data.frame(site = numeric(), name = character(), pct = numeric())
for(i in x){
if(!is.na(i) & !between(i, lfence, ufence)){
temp <- temp %>% add_row(site = s, name = n, pct = i)
}
}
}
